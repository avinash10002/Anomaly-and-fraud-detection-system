# MPLADS Auth Service — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8086
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret_at_least_64_characters_long
JWT_EXPIRES_IN=2h

# ── SMTP / Nodemailer ─────────────────────────────────────────────────────────
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Enter your email and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="MPLADS Audit System <your_email@gmail.com>"

# ── BCrypt ────────────────────────────────────────────────────────────────────
# Cost factor for bcrypt hashing of OTPs (10–12 is a reasonable default)
BCRYPT_ROUNDS=10

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max OTP requests per email in a 10-minute window
OTP_PER_EMAIL_MAX=3
OTP_PER_EMAIL_WINDOW_MS=600000

# Max OTP requests per IP in a 10-minute window
OTP_PER_IP_MAX=5
OTP_PER_IP_WINDOW_MS=600000

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRES_SECONDS=300
OTP_MAX_FAILURES=5
OTP_LOCKOUT_MINUTES=15

# ── Cookie ────────────────────────────────────────────────────────────────────
# Set COOKIE_SECURE=false when testing over HTTP locally; true in production
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
